@page
@model Stanciu_Oana_Lab2.Pages.Categories.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Category.CategoryName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>
    </dl>
</div>

<div>
    <h4>Cărți în această categorie</h4>
    @if (Model.Books != null && Model.Books.Any())
    {
        <ul>
            @foreach (var book in Model.Books)
            {
                <li>@book.Title - @book.Author?.FullName</li>
            }
        </ul>
    }
    else
    {
        <p>Nu există cărți în această categorie.</p>
    }
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Category.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
